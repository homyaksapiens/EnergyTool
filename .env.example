# Локальная разработка. На платформе хакатона адрес, ключ и модели подставляются автоматически.
# OpenAI-совместимый сервер: LM Studio → Developer → Start Server
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
# id модели из LM Studio (GET /v1/models); eval/run_local.py определяет его сам
LLM_MODEL=
# эмбеддинги (bge-m3) и реранкер; если модели нет — поиск только по BM25
EMB_MODEL=
RERANKER_MODEL=

# Веб-бэкенд
KB_PATH=data/knowledge-base.zip
DB_PATH=data/app.db
PORT=8000
# Панель менеджера: если пароль задан, заявки и список сессий открываются только по логину (по умолчанию manager)
MANAGER_USER=
MANAGER_PASSWORD=
# Показ входа клиента: каждый посетитель считается вошедшим с этим номером и видит «Ваши диалоги»
DEMO_CLIENT_PHONE=

# Уведомления менеджеру в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
