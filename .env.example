# OpenAI-совместимый API для генерации.
# Для LM Studio в Docker Desktop: http://host.docker.internal:1234/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Модели поиска. Для сервера только с генерацией установите оба флага в 0.
EMB_MODEL=
RERANKER_MODEL=
ET_USE_DENSE=1
ET_USE_RERANK=1

# Порт хоста при запуске через Docker Compose.
PORT=8000

# Локальный вход с вымышленными аккаунтами.
DEMO_AUTH=1

# HTTP Basic для панели менеджера, если DEMO_AUTH=0.
MANAGER_USER=
MANAGER_PASSWORD=

# Уведомления менеджеру в Telegram (необязательно).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
